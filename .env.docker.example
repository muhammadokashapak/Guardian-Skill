# Project Guardian - Docker Production Configuration (.env.docker.example)

# Application Environment
APP_ENV=production
APP_DEBUG=false

# MySQL Database Configuration
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=guardian_db
DB_USERNAME=guardian_user
DB_PASSWORD=guardian_secret_password
MYSQL_ROOT_PASSWORD=guardian_root_password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# AI Providers (Optional; falls back to deterministic rule-based analyzers)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_HOST=http://host.docker.internal:11434

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
