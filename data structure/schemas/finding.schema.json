{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "category",
    "severity",
    "confidence",
    "title",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "enum": [
        "open",
        "accepted",
        "in_progress",
        "fixed",
        "verified",
        "rejected",
        "false_positive"
      ]
    },
    "affected_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "line_start": {
      "type": [
        "integer",
        "null"
      ]
    },
    "line_end": {
      "type": [
        "integer",
        "null"
      ]
    },
    "evidence": {
      "type": "array"
    },
    "remediation": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}