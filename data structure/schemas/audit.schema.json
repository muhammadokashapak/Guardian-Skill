{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "project_id",
    "status",
    "started_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "completed",
        "partial",
        "failed",
        "blocked"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "findings": {
      "type": "array"
    },
    "scanner_results": {
      "type": "array"
    }
  }
}