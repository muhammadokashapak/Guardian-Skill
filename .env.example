# Project Guardian - Local Environment Configuration (.env.example)

# Application Environment
APP_ENV=development
APP_DEBUG=true

# Database Configuration (Defaults to SQLite for local standalone development)
DB_CONNECTION=sqlite
GUARDIAN_DB_PATH=guardian_production.db

# For MySQL (Uncomment to use MySQL)
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=guardian_db
# DB_USERNAME=root
# DB_PASSWORD=your_secure_password

# Redis Configuration (Optional for local development; defaults to threadpool queue)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# AI Providers (Optional; falls back to deterministic rule-based analyzers)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIzaSy...
# OLLAMA_HOST=http://localhost:11434

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
